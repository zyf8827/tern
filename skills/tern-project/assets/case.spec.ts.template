import { test, expect } from '@playwright/test';

// 可 import：@playwright/test、node: 内置、相对路径（_lib 工具库）、
// 用例仓库 package.json dependencies 里声明的包。禁止 import @tern/*。
// 声明了 auth（非 none）时 page 已带登录态；BASE_URL 已是 page 的 baseURL。
test('<用例名>', async ({ page }) => {
  await test.step('打开页面', async () => {
    await page.goto('/');
    await page.waitForLoadState('networkidle');
    console.log('当前 URL:', page.url());   // console.log 实时回传
  });

  await test.step('断言', async () => {
    // 用业务特征断言，不要只断言 URL
    // expect(page.locator(...)).toBeVisible();
  });
});
