{
  "name": "tern",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --test packages/case-bundler/dist/*.test.js apps/server/dist/*.test.js packages/exec-kit/dist/*.test.js apps/worker/dist/*.test.js",
    "test:e2e": "node scripts/e2e-test.mjs",
    "start:server": "pnpm --filter @tern/server start",
    "start:worker": "pnpm --filter @tern/worker start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
