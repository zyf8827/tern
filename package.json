{
  "name": "tern",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @tern/web build",
    "cli:dev": "pnpm --filter @tern/cli dev",
    "bundle:mcp": "node scripts/bundle-mcp.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:server": "pnpm --filter @tern/server start",
    "start:worker": "pnpm --filter @tern/worker start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
