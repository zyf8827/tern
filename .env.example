# 部署环境变量模板（实例文件 .env 与 docker-compose.yml 由 scripts/init-compose.sh 生成，均已 gitignore）
#   bash scripts/init-compose.sh          # 交互问答生成，回车 = 使用括号内默认值
#   bash scripts/init-compose.sh --yes    # 全部用默认值/已有 .env 值非交互生成
# 也可手工复制本文件为 .env 后按需修改；WORKER_TOKEN 必须设置。

# Worker 接入凭证（server 与所有 worker 必须一致；init-compose 默认生成随机值）
WORKER_TOKEN=please-change-me

# 对外端口
SERVER_PORT=7430

# 对外可达地址（通知消息里的「查看详情」链接用它拼；init-compose 自动探测宿主 IP 生成）
PUBLIC_URL=http://localhost:7430

# 宿主机资源映射目录（容器内对应 /app/data、/app/repos；相对路径 = 仓库根）
HOST_DATA_DIR=./data
HOST_REPOS_DIR=./repos

# worker 副本数（docker compose up 即生效；临时扩容也可 up -d --scale worker=N）
WORKER_REPLICAS=1

# 每个 worker 的并发执行槽
WORKER_MAX_SLOTS=1

# 源码热替换（true = compose 挂载宿主机构建产物 apps/*/dist、packages/*/dist、apps/server/public；
# 改码后宿主机 pnpm -r build，再 docker compose restart server worker 即生效，不需重建镜像。
# init-compose 选择开启后自动写入并取消 compose 中挂载行注释；要求宿主机可 pnpm 构建）
# SOURCE_MOUNT=true

# Worker 基础镜像（必须与 apps/worker/package.json 的 @playwright/test 版本一致；
# 注意部分版本仅有 jammy 变体，无 noble）
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.59.0-jammy

# ---- 镜像源配置（默认使用官方上游源，国内环境可按需开启镜像源加速）----
# APT_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com

# 镜像 tag（本地构建产物）
SERVER_IMAGE=tern-server:latest
WORKER_IMAGE=tern-worker:latest

# git 用例项目默认自动拉取间隔（秒）；0 = 仅手动更新
PULL_INTERVAL_SEC=300

# 日志级别（debug/info/warn/error）
LOG_LEVEL=info

# API 写操作 Bearer 认证（init-compose 选择开启后写入此变量，并自动取消 compose 中 API_TOKEN 行注释）
# API_TOKEN=

# 用例登录凭据示例（tern.yaml 中 ${ENV:XXX} 占位符的解析来源，也可逐批次参数提供；
# init-compose 注入后自动取消 compose 中的注释行）
# DEMO_USER=demo-user
# DEMO_PASS=demo-pass

# ---- 数据库配置（可选） ----
# 默认使用内嵌 SQLite（零配置，自动在 HOST_DATA_DIR 生成 platform.db）
# 若需外置数据库，支持 MySQL 或 PostgreSQL。支持 URL 或拆分参数：
# DB_DIALECT=sqlite    # 可选: sqlite, mysql, postgresql
# DB_PATH=/app/data/platform.db
# DATABASE_URL=mysql://user:pass@host:3306/db
#
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
